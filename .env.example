# global-gold-saas — secret template
#
# Local dev: copy this to `.streamlit/secrets.toml` and convert each KEY=VALUE
#   line to TOML format: KEY = "VALUE"
#
# Streamlit Cloud: paste the same TOML content into your app's
#   Settings -> Secrets dashboard.
#
# DO NOT commit the real secrets file. `.streamlit/secrets.toml` is already
# in .gitignore by default for Streamlit projects.

# --- GoldAPI.io  (free tier: 50 calls/month — 1h cache makes this safe)
# Sign up: https://www.goldapi.io/
GOLD_API_KEY = "goldapi-xxxxxxxxxxxxxxxxxx"

# --- Supabase  (free tier: 500 MB DB, 50K MAU, auto-pause after 1wk idle)
# Find these in: Supabase dashboard -> Project Settings -> API
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY = "YOUR_PROJECT_ANON_PUBLIC_KEY"

# --- Optional: override the news RSS source
# Default is Investing.com commodities-metals feed.
# NEWS_RSS_URL = "https://www.investing.com/rss/commodities_Metals.rss"
